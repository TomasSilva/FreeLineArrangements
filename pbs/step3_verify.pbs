#!/bin/bash
#PBS -N free_arr_verify
#PBS -q par16
#PBS -l nodes=1:ppn=16
#PBS -l walltime=240:00:00
#PBS -e logs/verify.err
#PBS -o logs/verify.out

cd $PBS_O_WORKDIR
echo "Job starting:" `date`
mkdir -p logs

module load python/3.8.11-intel-2021.3.0
source free_arr/bin/activate
export OMP_NUM_THREADS=16

# Step 3: Post-hoc exact Saito verification for large n
# Runs the model, collects candidates with valid combinatorial structure,
# then verifies each exactly with sympy. This is the slow step for large n.
for N in 13 14 15 16 17 18 19 20; do
  echo "========== Verifying n=$N =========="
  python main.py verify-found \
    --n $N \
    --n-max 20 \
    --model model_n20.pt \
    --coord-range 5 \
    --episodes 5000 \
    --singularity-aware \
    --max-candidates 200
done

echo "Job completed:" `date`