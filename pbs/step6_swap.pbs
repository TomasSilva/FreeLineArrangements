#!/bin/bash
#PBS -N swap_campaign
#PBS -q par16
#PBS -l nodes=1:ppn=16
#PBS -l walltime=24:00:00
#PBS -j oe

# Fixed-cardinality swap-search campaign over exponent cells.
#
# One node runs 14 parallel campaign units (cell x engine x seed), leaving
# headroom for the OS. Each unit is a single-process, wall-bounded,
# deterministic invocation of experiments/run_swap_campaign.py; outputs are
# append-only so requeues simply continue with fresh seeds.
#
# BEFORE FIRST USE on the cluster:
#   pip install --user numpy sympy scipy networkx   (torch NOT needed)
#   python -c "import swap_search"                  (smoke)
#
# Cell list: generated by experiments/gen_swap_jobs.py (jobs_swap.txt).
# Submit:    qsub -v JOBS_FILE=jobs_swap_tierA.txt pbs/step6_swap.pbs

cd "$PBS_O_WORKDIR"
module load python/3.8.11-intel 2>/dev/null || true
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1

JOBS_FILE=${JOBS_FILE:-jobs_swap_tierA.txt}
WALL_MIN=${WALL_MIN:-1380}   # 23h of the 24h walltime

echo "== swap campaign: $(wc -l < "$JOBS_FILE") units from $JOBS_FILE =="
date

# each line of JOBS_FILE is: n d1 d2 engine seed outdir
xargs -P 14 -L 1 -a "$JOBS_FILE" bash -c '
  set -- $0 "$@"
  n=$1; d1=$2; d2=$3; eng=$4; seed=$5; out=$6
  mkdir -p "$out"
  python experiments/run_swap_campaign.py \
      --n "$n" --d1 "$d1" --d2 "$d2" --engine "$eng" --seed "$seed" \
      --wall-minutes '"$WALL_MIN"' --out "$out" \
      >> "$out/log_${eng}_s${seed}.txt" 2>&1
'
date
echo "== done =="
