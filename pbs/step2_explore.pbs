#!/bin/bash
#PBS -N free_arr_explore
#PBS -q par16
#PBS -l nodes=1:ppn=16
#PBS -l walltime=48:00:00
#PBS -e logs/explore.err
#PBS -o logs/explore.out
#PBS -m abe

cd $PBS_O_WORKDIR
echo "Job starting:" `date`
mkdir -p logs

module load python/3.8.11-intel-2021.3.0
source free_arr/bin/activate
export OMP_NUM_THREADS=16

# Step 2: Greedy exploration from trained model
# Runs the trained policy to collect free arrangements for each target n.
for N in 10 12 14 15 16 17 18 19 20; do
  echo "========== Exploring n=$N =========="
  python main.py explore \
    --n $N \
    --n-max 20 \
    --model model_n20.pt \
    --coord-range 5 \
    --episodes 5000 \
    --singularity-aware \
    --max-candidates 200
done

echo "Job completed:" `date`